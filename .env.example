# RAJAN LORD AI - CONFIGURATION TEMPLATE
# Copy this to .env and fill in your actual values

# ============================================================================
# TELEGRAM CONFIGURATION
# ============================================================================

# Your Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=12345
API_HASH=your_api_hash_here

# Your Telegram bot token (get from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCDEfghijklmnopqrstuvwxyz_1234567890

# Session name for the bot
SESSION_NAME=rajan_lord_ai

# ============================================================================
# OWNER CONFIGURATION
# ============================================================================

# Your Telegram numeric user ID (get by sending /id to @userinfobot)
# IMPORTANT: Only this user can control the AI
OWNER_ID=123456789

# ============================================================================
# GROQ AI CONFIGURATION
# ============================================================================

# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use (recommended models):
# - mixtral-8x7b-32768 (fast, good quality)
# - llama2-70b-4096 (more powerful)
GROQ_MODEL=mixtral-8x7b-32768

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite database file path
DATABASE_PATH=rajan_lord_ai.db

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Directory for project backups
BACKUP_DIR=backups

# Directory for logs
LOGS_DIR=logs
